        {
          "name": "Create User - Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () {\n  pm.response.to.have.status(422);\n});\npm.test('has already been taken', function () {\n  const payload = pm.response.json();\n  let message = '';\n\n  if (Array.isArray(payload)) {\n    const emailError = payload.find(item => item.field === 'email' || item.field === 'Email');\n    message = emailError ? (emailError.message || emailError.msg || '') : '';\n  } else if (payload && payload.errors && Array.isArray(payload.errors)) {\n    const emailError = payload.errors.find(item => item.field === 'email' || item.field === 'Email');\n    message = emailError ? (emailError.message || emailError.msg || '') : '';\n  } else if (payload && payload.message) {\n    message = payload.message;\n  }\n\n  pm.expect(message).to.include('has already been taken');\n});"
                ]
              }
            }
          ],
