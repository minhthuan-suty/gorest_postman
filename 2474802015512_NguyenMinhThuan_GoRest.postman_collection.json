              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"user_id phải có giá trị\", function () {\n    const uid = pm.environment.get(\"user_id\");\n    pm.expect(uid, \"user_id is missing\").to.be.ok;\n});\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"ID khớp user vừa tạo\", function () {\n    const currentUserId = Number(pm.environment.get(\"user_id\"));\n    pm.expect(currentUserId).to.be.a(\"number\");\n    pm.expect(pm.response.json().id).to.eql(currentUserId);\n});"
                ]
              }
            }
          ],
