        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"user_id\");\npm.environment.unset(\"user_email\");\nconst base = pm.iterationData.get(\"email\") || \"test@example.com\";\nconst createdEmail = Date.now() + \".\" + base;\npm.environment.set(\"run_email\", createdEmail);\npm.environment.set(\"user_email\", createdEmail);\npm.test(\"Status code is 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\npm.test(\"Tạo user thành công và lưu user_id\", function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property(\"id\");\n    pm.environment.set(\"user_id\", json.id);\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "a9b96a8550ca7037b66ba8e8358ea5bcd8e15d32bb524c1918120acb96d4351b",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{run_email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
