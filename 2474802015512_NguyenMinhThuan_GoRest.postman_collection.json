        {
          "name": "Create User - Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {\n    pm.response.to.have.status(422);\n});\n\npm.test(\"Lỗi email đã tồn tại\", function () {\n    const payload = pm.response.json();\n    const emailError = Array.isArray(payload) ? payload.find(item => item.field === \"email\") : null;\n    const message = emailError ? emailError.message : (payload && payload.message) || \"\";\n    pm.expect(message).to.include(\"has already been taken\");\n});"
                ]
              }
            }
          ],
